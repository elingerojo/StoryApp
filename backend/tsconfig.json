{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
//    "rootDir": "./src",
    "outDir": "./dist",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "paths": {
      "@shared/*": ["../shared/*"]
    }
  },
  "include": ["src/**/*", 
    "../shared/**/*" // CRUCIAL: Le dice a tsc que permita compilar esta carpeta externa
  ]
}
