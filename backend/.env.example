# ============================================================
#  VARIABLES DE ENTORNO — Backend ScrollyTelling
# ============================================================
#  Copia este archivo como .env y completa los valores:
#    cp .env.example .env
# ============================================================

# ---- Google Gemini AI ----
# Obtén tu API Key en: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=tu_api_key_de_gemini

# ---- Neon (PostgreSQL) ----
# Connection string de tu base de datos Neon
# Ej: postgresql://user:pass@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://usuario:password@ep-xxxx.neon.tech/neondb?sslmode=require

# ---- Vercel Blobs (para subir SVGs) ----
# Obtén el token en: https://vercel.com > Storage > Blobs > Tokens
# Solo necesario si usas el endpoint POST /api/historias/:slug/upload-svg
BLOB_READ_WRITE_TOKEN=tu_token_de_vercel_blobs

# ---- Puerto del servidor (opcional) ----
# Default: 3000
# PORT=3000
